{

  description = "Flake to provide module options (both home-manager and nixos) for XIVLauncher";

  outputs =
    { self, nixpkgs }:
    let
      systems = [ "x86_64-linux" ];
      forAll = f: nixpkgs.lib.genAttrs systems (s: f nixpkgs.legacyPackages.${s});

      mkOptionsDoc =
        pkgs: path:
        let
          inherit (pkgs) lib;
          eval = lib.evalModules {
            modules = [
              (lib.setDefaultModuleLocation path (import path self))
              {
                _module.args.pkgs = pkgs;
                _module.check = false;
              }
            ];
          };
        in
        (pkgs.nixosOptionsDoc {
          options = removeAttrs eval.options [ "_module" ];
          # turn store paths into links to the source on GitHub
          transformOptions =
            opt:
            opt
            // {
              declarations = map (
                d:
                let
                  file = if lib.pathIsDirectory d then "${toString d}/default.nix" else toString d;
                  rel = lib.removePrefix "${self}/" file;
                in
                {
                  name = rel;
                  url = "https://github.com/NekoDrone/xiv-flake/blob/main/${rel}";
                }
              ) opt.declarations;
            };
        }).optionsCommonMark;
    in
    {
      packages = forAll (pkgs: {
        reshade = pkgs.callPackage ./pkgs/reshade.nix { };

        # nix build .#docs && install -m644 result docs/options.md
        docs = pkgs.runCommand "options.md" { } ''
          {
            echo "# Options"
            echo
            echo "<!-- Generated by \`nix build .#docs\`. Do not edit by hand. -->"
            echo
            echo "## Home Manager"
            echo
            sed 's/^## /### /' ${mkOptionsDoc pkgs ./modules/home}
            echo
            echo "## NixOS"
            echo
            sed 's/^## /### /' ${mkOptionsDoc pkgs ./modules/nixos.nix}
          } > $out
        '';
      });

      overlays.default = final: _: {
        xivlauncher-reshade = final.callPackage ./pkgs/reshade.nix { };
        # requires unfree 
        xivlauncher-d3dcompiler-url = final.callPackage ./pkgs/d3d-url.nix { };
      };

      homeManagerModules.default = import ./modules/home self;
      nixosModules.default = import ./modules/nixos.nix self;
    };

}
